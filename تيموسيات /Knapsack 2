const int N=1e5+55;
int dp[105][N];int n,wi;
int w[107],val[107];
int clc(int i,int v) {
    if (i==n) {
       if (v==0)
           return 0;

        return 1e18;
    }
    int &ret = dp[i][v];
    if (~ret) {
        return ret;
    }
    ret=1e18;
    ret=min(ret,clc(i+1,v));
    if (v>=val[i])
        ret=min(ret,w[i]+clc(i+1,v-val[i]));
    return ret;
}
void solve() {
    cin >> n>>wi;memset(dp,-1,sizeof(dp));
    for (int i=0;i<n;i++) {
        cin>>w[i]>>val[i];
    }

   for (int i=1e5;i>=0;i--) {
       if (clc(0,i)<=wi) {
           return void(cout<<i<<el);
       }
   }


}


